generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model answer {
  answer_id          BigInt           @id @default(autoincrement())
  assessment_id      BigInt
  question_id        BigInt
  question_option_id Int?
  answer_value       Int              @db.SmallInt
  weight             Decimal?         @db.Decimal(5, 2)
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  assessment         assessment       @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_answer_assessment")
  question           question         @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_answer_question")
  question_option    question_option? @relation(fields: [question_option_id], references: [option_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_answer_question_option")

  @@unique([assessment_id, question_id], map: "uq_assessment_question")
  @@index([assessment_id], map: "idx_answer_assessment")
  @@index([question_id], map: "idx_answer_question")
  @@index([question_option_id], map: "idx_answer_question_option")
}

model assessment {
  assessment_id               BigInt                        @id @default(autoincrement())
  biodata_id                  BigInt
  status                      String?                       @default("DRAFT") @db.VarChar(20)
  started_at                  DateTime?                     @db.Timestamp(6)
  completed_at                DateTime?                     @db.Timestamp(6)
  created_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  assessment_type             String                        @default("SELF") @db.VarChar(20)
  evaluator_name              String?                       @db.VarChar(120)
  evaluator_relationship      String?                       @db.VarChar(80)
  public_session_token        String?                       @unique @db.VarChar(64)
  answer                      answer[]
  biodata                     biodata                       @relation(fields: [biodata_id], references: [biodata_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_assessment_biodata")
  assessment_dimension_result assessment_dimension_result[]
  assessment_result           assessment_result[]

  @@index([biodata_id], map: "idx_assessment_biodata")
}

model assessment_dimension_result {
  assessment_dimension_id BigInt     @id @default(autoincrement())
  assessment_id           BigInt
  dimension_id            BigInt
  score                   Decimal?   @db.Decimal(5, 2)
  percentage              Decimal?   @db.Decimal(5, 2)
  created_at              DateTime?  @default(now()) @db.Timestamp(6)
  assessment              assessment @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_assessment_dimension_assessment")
  dimension               dimension  @relation(fields: [dimension_id], references: [dimension_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assessment_dimension_dimension")

  @@index([assessment_id], map: "idx_assessment_dimension_assessment")
  @@index([dimension_id], map: "idx_assessment_dimension_dimension")
}

model assessment_result {
  assessment_result_id BigInt          @id @default(autoincrement())
  assessment_id        BigInt
  profession_unit_id   BigInt
  percentage           Decimal         @db.Decimal(5, 2)
  rank_order           Int?
  is_recommended       Boolean?        @default(false)
  created_at           DateTime?       @default(now()) @db.Timestamp(6)
  assessment           assessment      @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_assessment_result_assessment")
  profession_unit      profession_unit @relation(fields: [profession_unit_id], references: [profession_unit_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_assessment_result_profession_unit")

  @@index([assessment_id], map: "idx_assessment_result_assessment")
  @@index([profession_unit_id], map: "idx_assessment_result_profession_unit")
}

model biodata {
  biodata_id                   BigInt                        @id @default(autoincrement())
  user_id                      BigInt                        @unique
  nama_lengkap                 String?                       @db.VarChar(150)
  jenis_kelamin                String?                       @db.VarChar(20)
  tempat_lahir                 String?                       @db.VarChar(100)
  tanggal_lahir                DateTime?                     @db.Date
  alamat                       String?
  kabupaten_kota               String?                       @db.VarChar(100)
  provinsi                     String?                       @db.VarChar(100)
  no_hp                        String?                       @db.VarChar(20)
  email                        String?                       @db.VarChar(150)
  education_level_id           BigInt?
  jurusan                      String?                       @db.VarChar(150)
  status_pekerjaan             String?                       @db.VarChar(50)
  profession_id                BigInt?
  instansi                     String?                       @db.VarChar(150)
  unit_kerja                   String?                       @db.VarChar(150)
  jabatan                      String?                       @db.VarChar(150)
  lama_pengalaman_kerja        Int?
  foto                         String?
  assessment_share_token       String?                       @unique @db.VarChar(64)
  assessment                   assessment[]
  assessment_ai_recommendation assessment_ai_recommendation?
  education_level              education_level?              @relation(fields: [education_level_id], references: [education_level_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_biodata_education")
  profession                   profession?                   @relation(fields: [profession_id], references: [profession_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_biodata_profession")
  users                        users                         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_biodata_user")

  @@index([profession_id], map: "idx_biodata_profession")
  @@index([user_id], map: "idx_biodata_user")
}

model dimension {
  dimension_id                BigInt                        @id @default(autoincrement())
  profession_id               BigInt
  dimension_name              String                        @db.VarChar(100)
  order_no                    Int?
  assessment_dimension_result assessment_dimension_result[]
  profession                  profession                    @relation(fields: [profession_id], references: [profession_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_dimension_profession")
  profession_unit_dimension   profession_unit_dimension[]
  question                    question[]

  @@index([profession_id], map: "idx_dimension_profession")
}

model education_level {
  education_level_id BigInt    @id @default(autoincrement())
  education_name     String    @db.VarChar(100)
  biodata            biodata[]
}

model profession {
  profession_id   BigInt            @id @default(autoincrement())
  profession_name String            @db.VarChar(100)
  description     String?
  biodata         biodata[]
  dimension       dimension[]
  profession_unit profession_unit[]
}

model profession_unit {
  profession_unit_id        BigInt                      @id @default(autoincrement())
  profession_id             BigInt
  unit_name                 String                      @db.VarChar(1000)
  assessment_result         assessment_result[]
  profession                profession                  @relation(fields: [profession_id], references: [profession_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_profession_unit_profession")
  profession_unit_dimension profession_unit_dimension[]

  @@index([profession_id], map: "idx_profession_unit_profession")
}

model profession_unit_dimension {
  profession_unit_dimension_id BigInt          @id @default(autoincrement())
  profession_unit_id           BigInt
  dimension_id                 BigInt
  weight                       Decimal         @db.Decimal(5, 2)
  created_at                   DateTime?       @default(now()) @db.Timestamp(6)
  dimension                    dimension       @relation(fields: [dimension_id], references: [dimension_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pud_dimension")
  profession_unit              profession_unit @relation(fields: [profession_unit_id], references: [profession_unit_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pud_profession_unit")

  @@unique([profession_unit_id, dimension_id], map: "uq_profession_unit_dimension")
  @@index([dimension_id], map: "idx_pud_dimension")
  @@index([profession_unit_id], map: "idx_pud_profession_unit")
}

model question {
  question_id     BigInt            @id @default(autoincrement())
  dimension_id    BigInt
  question        String
  question_order  Int?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  answer          answer[]
  dimension       dimension         @relation(fields: [dimension_id], references: [dimension_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_question_dimension")
  question_option question_option[]

  @@index([dimension_id], map: "idx_question_dimension")
}

enum organization_role {
  MEMBER
  SUPERVISOR
}

model organization {
  organization_id BigInt   @id @default(autoincrement())
  name            String   @db.VarChar(150)
  description     String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)
  members         users[]
}

/// Database checks prevent self-mentoring and supervisors without an organization.
model users {
  user_id           BigInt            @id @default(autoincrement())
  email             String            @unique @db.VarChar(150)
  password          String            @db.VarChar(255)
  role              String            @default("USER") @db.VarChar(20)
  is_active         Boolean?          @default(true)
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  updated_at        DateTime?         @default(now()) @db.Timestamp(6)
  biodata           biodata?
  /// Nullable while existing accounts await organization assignment.
  organization_id   BigInt?
  organization_role organization_role @default(MEMBER)
  mentor_id         BigInt?
  organization      organization?     @relation(fields: [organization_id], references: [organization_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_users_organization")
  mentor            users?            @relation("UserMentorship", fields: [mentor_id], references: [user_id], onDelete: SetNull, onUpdate: Cascade, map: "fk_users_mentor")
  mentees           users[]           @relation("UserMentorship")

  @@index([organization_id, organization_role], map: "idx_users_organization_role")
  @@index([mentor_id], map: "idx_users_mentor")
}

model assessment_ai_recommendation {
  ai_recommendation_id         BigInt    @id @default(autoincrement())
  biodata_id                   BigInt    @unique
  top_5_development_priorities Json
  development_recommendation   Json
  individual_career_roadmap    Json
  individual_development_plan  Json
  recommended_learning_path    Json
  recommended_learning_place   Json
  personal_commitment          Json
  created_at                   DateTime? @default(now()) @db.Timestamp(6)
  biodata                      biodata   @relation(fields: [biodata_id], references: [biodata_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_rec_biodata")
}

model question_option {
  option_id    Int       @id @default(autoincrement())
  question_id  BigInt
  option_order Int
  option_text  String
  weight       Decimal   @default(0) @db.Decimal(5, 2)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  question     question  @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_question_option_question")
  answer       answer[]

  @@unique([question_id, option_order], map: "uq_question_option_order")
}
